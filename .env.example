# Copy to .env and fill in. NEVER commit .env.
APP_ENV=prod
PUBLIC_BASE_URL=https://otvet.example.ru

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored Telegram/VK tokens unreadable: keep a copy in your secret manager.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# LLM: extractive (no model, works out of the box) | yandex | openai (any OpenAI-compatible API)
LLM_PROVIDER=extractive
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Payments (optional). Without them tariffs are switched by the operator in /admin.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Owner e-mail notifications (optional; Telegram notifications work without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

MESSAGE_RETENTION_DAYS=180
